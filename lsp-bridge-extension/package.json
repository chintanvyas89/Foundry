{
  "name": "swe-search-lsp-bridge",
  "displayName": "Local Semantic Search — LSP Bridge",
  "description": "Local, offline semantic code search with no LLM: a Search by meaning / Find similar UI plus an LSP symbol bridge for the semantic search MCP server. Local-only named pipe, no network access, no runtime dependencies beyond VS Code itself.",
  "version": "0.7.0",
  "publisher": "internal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chintanvyas89/Foundry.git",
    "directory": "lsp-bridge-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sweSearch",
          "title": "Semantic Search",
          "icon": "media/search.svg"
        }
      ]
    },
    "views": {
      "sweSearch": [
        {
          "id": "sweSearch.panel",
          "name": "Search",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "sweSearch.searchByMeaning",
        "title": "Search by meaning",
        "category": "Semantic Search"
      },
      {
        "command": "sweSearch.findSimilar",
        "title": "Find similar code",
        "category": "Semantic Search"
      },
      {
        "command": "sweSearch.focusPanel",
        "title": "Open search panel",
        "category": "Semantic Search"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sweSearch.findSimilar",
          "when": "editorHasSelection",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sweSearch.searchByMeaning",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "Local Semantic Search",
      "properties": {
        "sweSearch.serverEntry": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the built MCP server entry, e.g. `/path/to/local-semantic-search-mcp/dist/index.js`. Required for the **Search by meaning** and **Find similar** commands."
        },
        "sweSearch.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to the Node.js executable used to run the search server. Set an absolute path if VS Code can't find node (common with nvm), e.g. /home/you/.nvm/versions/node/vXX/bin/node."
        },
        "sweSearch.topK": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "description": "How many results each search returns."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^3.0.0"
  }
}
